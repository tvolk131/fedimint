fn main() {
    jet::bip_0340_verify((param::OWNER, jet::fm_sig_hash_all()), witness::SIGNATURE);
    assert!(jet::le_64(param::MIN_SESSION, jet::fm_session_index()));
    assert!(jet::le_64(param::MIN_BLOCK_COUNT, jet::fm_block_count()));

    match witness::RELEASE {
        true => {},
        false => {
            assert!(jet::le_64(jet::fm_current_amount(), jet::fm_output_amount(0)));
            assert!(jet::eq_256(jet::fm_current_cmr(), jet::fm_output_cmr(0)));
            assert!(jet::eq_256(jet::fm_current_state(), jet::fm_output_state(0)));
        },
    }
}
